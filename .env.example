# ==========================================================================
# ansem.tips — environment variables
# Copy to .env / .env.local and fill values. NEVER commit real secrets.
# HOT_WALLET_SECRET especially must stay private.
# ==========================================================================

# --- App ---
# Set DEMO_MODE=true only for local mocks. When false (default), real
# Privy / X / Solana paths run whenever their credentials below are present.
DEMO_MODE=
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:./dev.db
CRON_SECRET=

# --- Tipper allowlist (comma-separated; v0 trial = heettike) ---
TIPPER_X_USERNAME=heettike
TIPPER_ALLOWLIST=heettike
# Future prod tipper: blknoiz6

# --- $ansem (Solana) ---
ANSEM_MINT=9cRCn9rGT8V2imeM2BaKs13yhMEais3ruM3rPvTGpump
GRATITUDE_WALLET=G4uHQ85j65KBsypPH6qVqoiSYUBuH9YTAqRpuhjLRJBq
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Base58-encoded secret key for the custody hot wallet (withdrawals)
HOT_WALLET_SECRET=
# Optional: public address of hot wallet (for deposit instructions / balance checks)
HOT_WALLET_ADDRESS=
ANSEM_DECIMALS=6

# --- Limits (USD-notional $ansem units) ---
MIN_DEPOSIT_USD=100
MIN_TIP_USD=1

# --- Privy (X OAuth + embedded Solana wallets) ---
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- X / Twitter API v2 ---
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BOT_USER_ID=
