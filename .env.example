HOT_WALLET_SECRET=

# Claims + alerts
CLAIM_EXPIRY_DAYS=30
# Telegram low-balance fallback until the X bot exists
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
