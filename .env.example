TWITTER_CLIENT_SECRET=
# Privy Dashboard: Login Methods -> Twitter -> custom creds + toggle Return OAuth tokens
# Recommended scopes: tweet.read users.read like.read offline.access follows.read

# Custody hot wallet (payouts) — NEVER commit real values
# Fund with $ansem (Token-2022) + SOL for fees. Withdraw path uses HOT_WALLET_* only — no fake withdraws.
