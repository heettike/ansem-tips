// Ansem Tips — Prisma schema (Postgres on Vercel/Neon; DATABASE_URL from env)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums stored as strings (tipper|recipient, action types, tip statuses)
model User {
  id            String   @id @default(cuid())
  xId           String   @unique
  username      String
  privyDid      String?  @unique
  walletAddress String?
  role          String   @default("recipient")
  /// X OAuth 2.0 user-context tokens (from Privy useOAuthTokens → /api/auth/sync). Never paste manually.
  twitterAccessToken      String?
  twitterRefreshToken     String?
  twitterTokenExpiresAt   DateTime?
  /// Last observed SPL $ansem balance on tipper Privy Solana wallet (deposit watcher baseline)
  lastSeenTokenBalance    Float?
  /// Last login or withdrawal — claims expire when stale past CLAIM_EXPIRY_DAYS
  lastActiveAt            DateTime?
  /// Tipping starts only after login + Privy Solana wallet. Null = unarmed (baseline only, never pay).
  tipsArmedAt             DateTime?
  /// First follow poll after arming records current following as seen; later polls may pay new follows.
  followBaselineAt        DateTime?
  /// EVM address (Privy embedded or user-provided) for base/bsc/robinhood deposits
  evmAddress              String?

  tokenBalances TokenBalance[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tipSettings  TipSettings?
  tipsSent     Tip[]         @relation("TipsSent")
  tipsReceived Tip[]         @relation("TipsReceived")
  balance      Balance?
  withdrawals  Withdrawal[]
}

/// Per-tipper tip amounts (USD-notional $ansem). Structured for future multi-tipper (up to 100).
model TipSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likeAmount     Float    @default(1)
  commentAmount  Float    @default(1)
  followAmount   Float    @default(1)
  quoteAmount    Float    @default(1)
  superTipAmount Float    @default(5)
  /// Comments only tip when they contain this (case-insensitive; can be emoji-only)
  commentTrigger String   @default("lfg")
  /// Comments/QTs containing this upgrade to super_tip
  superTipTrigger String  @default("🐂")
  /// Tip token: chain from chains.ts registry; empty tokenAddress = default $ansem
  tipChain         String @default("solana")
  tipTokenAddress  String @default("")
  tipTokenSymbol   String @default("ansem")
  tipTokenDecimals Int    @default(6)
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Tip {
  id          String   @id @default(cuid())
  actionType  String
  actionId    String   @unique
  fromUserId  String
  fromUser    User     @relation("TipsSent", fields: [fromUserId], references: [id])
  toUserId    String?
  toUser      User?    @relation("TipsReceived", fields: [toUserId], references: [id])
  toXUsername String
  toXId       String?
  amount      Float
  /// Token unit of this tip (empty tokenAddress = default $ansem on solana)
  chain        String  @default("solana")
  tokenAddress String  @default("")
  tokenSymbol  String  @default("ansem")
  txSig       String?
  status      String   @default("pending")
  metadata    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model Balance {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tipper deposited $ansem available to tip (ledger)
  deposited        Float    @default(0)
  /// Recipient withdrawable earned $ansem (ledger)
  withdrawable     Float    @default(0)
  /// Lifetime tips sent / received
  lifetimeSent     Float    @default(0)
  lifetimeReceived Float    @default(0)
  updatedAt        DateTime @updatedAt
}

/// Recipient SPL withdrawals from custody hot wallet
model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  /// Token withdrawn (empty tokenAddress = default $ansem on solana)
  chain        String @default("solana")
  tokenAddress String @default("")
  tokenSymbol  String @default("ansem")
  toAddress String
  txSig     String   @unique
  status    String   @default("completed")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Per-token ledger for non-default tokens (default $ansem stays on Balance)
model TokenBalance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain        String
  tokenAddress String
  symbol       String
  decimals     Int      @default(18)
  deposited    Float    @default(0)
  withdrawable Float    @default(0)
  /// Deposit watcher baseline (onchain balance at last check)
  lastSeenOnchain Float?
  updatedAt    DateTime @updatedAt

  @@unique([userId, chain, tokenAddress])
  @@index([userId])
}

/// Dedupe store — never double-process an X action
model ProcessedAction {
  id          String   @id @default(cuid())
  actionId    String   @unique
  actionType  String
  tipperXId   String
  processedAt DateTime @default(now())

  @@index([tipperXId])
}
